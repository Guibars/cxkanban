rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules for the CX app: logged in users can read and write all cases
    match /cx_cases/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ra_cases/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /integrator_visits/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
