rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && (
          request.auth.token.email == 'guilhermebarbosars@gmail.com'
          || request.auth.token.email.matches('^[^@]+@fotus[.]com[.]br$')
        );
    }

    function isDeveloper() {
      return isAuthorizedUser() && request.auth.token.email == 'guilhermebarbosars@gmail.com';
    }

    function canManagePeople() {
      return isDeveloper()
        || (
          exists(/databases/$(database)/documents/user_access/$(request.auth.token.email))
          && get(/databases/$(database)/documents/user_access/$(request.auth.token.email)).data.active == true
          && get(/databases/$(database)/documents/user_access/$(request.auth.token.email)).data.role in ['Administrador', 'Coordenador', 'Líder']
        );
    }

    function hasNumericTimestamps(data) {
      return data.createdAt is int && data.updatedAt is int;
    }

    match /cx_cases/{caseId} {
      allow read: if isDeveloper();
      allow create: if isDeveloper()
        && request.resource.data.orderNumber is string
        && request.resource.data.productCode is string
        && request.resource.data.quantity is int
        && request.resource.data.status is string
        && request.resource.data.observations is string
        && hasNumericTimestamps(request.resource.data);
      allow update: if isDeveloper()
        && request.resource.data.orderNumber is string
        && request.resource.data.productCode is string
        && request.resource.data.quantity is int
        && request.resource.data.status is string
        && request.resource.data.updatedAt is int;
      allow delete: if isDeveloper();
    }

    match /ra_cases/{caseId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser()
        && request.resource.data.raNumber is string
        && request.resource.data.customerName is string
        && request.resource.data.status is string
        && request.resource.data.createdByEmail == request.auth.token.email
        && hasNumericTimestamps(request.resource.data);
      allow update: if isAuthorizedUser()
        && request.resource.data.raNumber is string
        && request.resource.data.customerName is string
        && request.resource.data.status is string
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.updatedAt is int;
      allow delete: if isAuthorizedUser();
    }

    match /integrator_visits/{visitId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser()
        && request.resource.data.integratorName is string
        && request.resource.data.contactPerson is string
        && request.resource.data.visitDate is string
        && request.resource.data.status is string
        && request.resource.data.createdByEmail == request.auth.token.email
        && hasNumericTimestamps(request.resource.data);
      allow update: if isAuthorizedUser()
        && request.resource.data.integratorName is string
        && request.resource.data.visitDate is string
        && request.resource.data.status is string
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.updatedAt is int;
      allow delete: if isAuthorizedUser();
    }

    match /organization_units/{unitId} {
      allow read: if isAuthorizedUser();
      allow create: if canManagePeople()
        && request.resource.data.department is string
        && request.resource.data.teamName is string
        && request.resource.data.regional is string
        && request.resource.data.managerName is string
        && request.resource.data.managerEmail is string
        && request.resource.data.leaderName is string
        && request.resource.data.leaderEmail is string
        && (!request.resource.data.keys().hasAny(['coordinatorName']) || request.resource.data.coordinatorName is string)
        && (!request.resource.data.keys().hasAny(['coordinatorEmail']) || request.resource.data.coordinatorEmail is string)
        && request.resource.data.active is bool
        && hasNumericTimestamps(request.resource.data);
      allow update: if canManagePeople()
        && request.resource.data.department is string
        && request.resource.data.teamName is string
        && request.resource.data.managerName is string
        && request.resource.data.leaderName is string
        && (!request.resource.data.keys().hasAny(['coordinatorName']) || request.resource.data.coordinatorName is string)
        && (!request.resource.data.keys().hasAny(['coordinatorEmail']) || request.resource.data.coordinatorEmail is string)
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is int;
      allow delete: if isDeveloper();
    }

    match /organization_people/{personId} {
      allow read: if isAuthorizedUser();
      allow create: if canManagePeople()
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role in ['Head', 'Gerente', 'Coordenador', 'Líder']
        && (!request.resource.data.keys().hasAny(['reportsToId']) || request.resource.data.reportsToId == null || request.resource.data.reportsToId is string)
        && (!request.resource.data.keys().hasAny(['reportsToName']) || request.resource.data.reportsToName == null || request.resource.data.reportsToName is string)
        && request.resource.data.department is string
        && request.resource.data.regional is string
        && request.resource.data.active is bool
        && request.resource.data.createdByEmail == request.auth.token.email
        && hasNumericTimestamps(request.resource.data);
      allow update: if canManagePeople()
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role in ['Head', 'Gerente', 'Coordenador', 'Líder']
        && (!request.resource.data.keys().hasAny(['reportsToId']) || request.resource.data.reportsToId == null || request.resource.data.reportsToId is string)
        && (!request.resource.data.keys().hasAny(['reportsToName']) || request.resource.data.reportsToName == null || request.resource.data.reportsToName is string)
        && request.resource.data.department is string
        && request.resource.data.regional is string
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is int;
      allow delete: if canManagePeople();
    }

    match /occurrences/{occurrenceId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser()
        && request.resource.data.date is string
        && request.resource.data.agentName is string
        && request.resource.data.companyName is string
        && request.resource.data.state is string
        && request.resource.data.region is string
        && request.resource.data.orderNumber is string
        && request.resource.data.sacCode is string
        && request.resource.data.occurrenceType is string
        && request.resource.data.product is string
        && request.resource.data.quantity is int
        && request.resource.data.stage is string
        && request.resource.data.approvalStatus is string
        && request.resource.data.carrier is string
        && (!request.resource.data.keys().hasAny(['isDamage']) || request.resource.data.isDamage is bool)
        && (!request.resource.data.keys().hasAny(['damageAmount']) || request.resource.data.damageAmount is number)
        && (!request.resource.data.keys().hasAny(['city']) || request.resource.data.city is string)
        && hasNumericTimestamps(request.resource.data);
      allow update: if isAuthorizedUser()
        && request.resource.data.date is string
        && request.resource.data.agentName is string
        && request.resource.data.companyName is string
        && request.resource.data.quantity is int
        && request.resource.data.stage is string
        && request.resource.data.approvalStatus is string
        && (!request.resource.data.keys().hasAny(['isDamage']) || request.resource.data.isDamage is bool)
        && (!request.resource.data.keys().hasAny(['damageAmount']) || request.resource.data.damageAmount is number)
        && (!request.resource.data.keys().hasAny(['city']) || request.resource.data.city is string)
        && request.resource.data.updatedAt is int;
      allow delete: if isAuthorizedUser();
    }

    match /extra_costs/{costId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser()
        && request.resource.data.date is string
        && request.resource.data.orderNumber is string
        && request.resource.data.regional is string
        && request.resource.data.product is string
        && request.resource.data.quantity is int
        && request.resource.data.origin is string
        && request.resource.data.productCost is number
        && request.resource.data.logisticsCost is number
        && request.resource.data.taxCost is number
        && request.resource.data.totalCost is number
        && request.resource.data.responsible is string
        && request.resource.data.reasonCategory is string
        && request.resource.data.detailedReason is string
        && hasNumericTimestamps(request.resource.data);
      allow update: if isAuthorizedUser()
        && request.resource.data.date is string
        && request.resource.data.orderNumber is string
        && request.resource.data.quantity is int
        && request.resource.data.totalCost is number
        && request.resource.data.responsible is string
        && request.resource.data.updatedAt is int;
      allow delete: if isAuthorizedUser();
    }

    match /app_settings/{settingId} {
      allow read: if isAuthorizedUser();
      allow create, update: if canManagePeople()
        && settingId == 'occurrence_agents'
        && request.resource.data.names is list
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    match /user_access/{userEmail} {
      allow read: if isAuthorizedUser();
      allow create, update: if isDeveloper()
        && request.resource.data.email == userEmail
        && request.resource.data.displayName is string
        && request.resource.data.role is string
        && request.resource.data.organizationUnitIds is list
        && request.resource.data.visibleTabs is list
        && request.resource.data.active is bool
        && hasNumericTimestamps(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
